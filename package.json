{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write --cache \"**/*.{blade.php,ts,js,css,md,json,yml,xml,astro}\"",
        "test:e2e": "cypress open",
        "test:e2e:headless": "cypress run --env SKIP_DATABASE_REBUILD=true",
        "test:e2e:skip-rebuild": "cypress open --env SKIP_DATABASE_REBUILD=true",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@pierre/diffs": "^1.3.6",
        "@sentry/browser": "^10.72.0",
        "bootstrap": "^5.3.8",
        "clipboard": "^2.0.11",
        "tom-select": "^2.6.2"
    },
    "devDependencies": {
        "@fortawesome/fontawesome-free": "^7.3.1",
        "@popperjs/core": "^2.11.8",
        "@prettier/plugin-xml": "^3.4.2",
        "@sentry/vite-plugin": "^5.4.0",
        "@shufo/prettier-plugin-blade": "^1.16.2",
        "@tailwindcss/vite": "^4.3.3",
        "@types/alpinejs": "^3.13.11",
        "@types/node": "^26.4.0",
        "autoprefixer": "^10.5.4",
        "axios": "^1.20.0",
        "concurrently": "^10.0.5",
        "cypress": "^15.21.1",
        "cypress-axe": "^1.7.0",
        "cypress-ctrf-json-reporter": "^0.0.14",
        "cypress-wait-until": "^3.0.2",
        "laravel-vite-plugin": "^3.2.0",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.0.2",
        "sass": "^1.103.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.2.2"
    },
    "engines": {
        "node": ">= 26.0.0",
        "npm": "please-use-pnpm",
        "pnpm": ">= 11.0.0",
        "yarn": "please-use-pnpm"
    }
