<?xml version="1.0" encoding="UTF-8" ?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="vendor/autoload.php"
    cacheDirectory=".phpunit.cache"
    colors="true"
    failOnPhpunitWarning="false"
    displayDetailsOnIncompleteTests="true"
    displayDetailsOnPhpunitDeprecations="true"
    displayDetailsOnTestsThatTriggerWarnings="true"
    displayDetailsOnTestsThatTriggerNotices="true"
    displayDetailsOnTestsThatTriggerDeprecations="true"
    displayDetailsOnTestsThatTriggerErrors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <!--
                Code Coverage Exclusions

                Excluded items are boilerplate, third-party, declarative, or
                framework-generated code where coverage metrics add no value.

                NOTE: Do not exclude directories/files that have tests with
                #[CoversClass] or #[CoversTrait] attributes targeting them.
                PHPUnit will emit warnings when coverage is active and the
                target is excluded.
            -->

            <!-- Enums (declarative values, labels, colors) -->
            <file>app/Domains/Auth/Enums/AccessTokenStatus.php</file>
            <file>app/Domains/Auth/Enums/AuthType.php</file>
            <file>app/Domains/Auth/Enums/SystemPermission.php</file>
            <file>app/Domains/Auth/Enums/PermissionScope.php</file>
            <file>app/Domains/Auth/Enums/RoleModificationOrigin.php</file>
            <file>app/Domains/Auth/Enums/RoleTypeEnum.php</file>
            <file>app/Domains/Auth/Enums/SystemRole.php</file>
            <directory>app/Domains/Core/Enums</directory>
            <directory>app/Domains/Support/Enums</directory>
            <file>app/Domains/User/Enums/Affiliation.php</file>
            <file>app/Domains/User/Enums/NetIdUpdateAction.php</file>
            <file>app/Domains/User/Enums/UserSegment.php</file>

            <!-- Models (casts, relationships, property declarations) -->
            <directory>app/Domains/Auth/Models</directory>
            <file>app/Domains/Core/Models/BaseModel.php</file>
            <directory>app/Domains/Support/Models</directory>
            <file>app/Domains/User/Models/User.php</file>
            <file>app/Domains/User/Models/Audit.php</file>
            <file>app/Domains/User/Models/Export.php</file>
            <file>app/Domains/User/Models/ImpersonationLog.php</file>
            <file>app/Domains/User/Models/UserLoginRecord.php</file>

            <!-- Seeders -->
            <directory>app/Domains/Auth/Seeders</directory>
            <directory>app/Domains/Support/Seeders</directory>
            <directory>app/Domains/User/Seeders</directory>
            <file>app/Domains/Core/Seeders/IdempotentSeeder.php</file>

            <!-- Config validators -->
            <file
            >app/Domains/Core/Services/ConfigValidation/AppKeyValidator.php</file>
            <file
            >app/Domains/Core/Services/ConfigValidation/DatabaseValidator.php</file>
            <file
            >app/Domains/Core/Services/ConfigValidation/FilesystemValidator.php</file>
            <file
            >app/Domains/Core/Services/ConfigValidation/QueueValidator.php</file>

            <!-- Contracts / Interfaces -->
            <directory>app/Domains/Auth/Contracts</directory>
            <directory>app/Domains/Core/Contracts</directory>
            <directory>app/Domains/Support/Contracts</directory>

            <!-- Value Objects (constants, readonly data containers) -->
            <directory>app/Domains/Auth/ValueObjects</directory>
            <directory>app/Domains/Core/ValueObjects</directory>
            <file>app/Domains/Support/Gateways/CreationResult.php</file>

            <!-- API Resources -->
            <directory>app/Domains/Auth/Http/Resources</directory>
            <directory>app/Domains/User/Http/Resources</directory>

            <!-- Framework boilerplate / third-party -->
            <directory>app/Domains/Core/Concerns</directory>
            <file
            >app/Domains/Core/Database/ConfigurableDbDumperFactory.php</file>
            <file>app/Domains/Core/Database/SchemaChecksumManager.php</file>
            <directory>app/Domains/Core/Exceptions</directory>
            <directory>app/Domains/Core/GlobalAlerts</directory>
            <directory>app/Domains/User/Exceptions</directory>
            <directory>app/Domains/Support/Exceptions</directory>
            <directory>app/Filament</directory>
            <file>app/Domains/Auth/Http/Controllers/WebSSOController.php</file>
            <file>app/Http/Controllers/Controller.php</file>
            <file>app/Http/Controllers/Api/BaseApiController.php</file>
            <file>app/Http/Controllers/Api/V1/ApiController.php</file>
            <file>app/View/Components/Breadcrumbs.php</file>
            <file>app/View/Components/ErrorLayout.php</file>

            <!-- Service Providers (bootstrap wiring, no domain logic) -->
            <file>app/Providers/AppServiceProvider.php</file>
            <file>app/Providers/EloquentServiceProvider.php</file>
            <file>app/Providers/FilamentServiceProvider.php</file>
            <file>app/Providers/Filament/AdministrationPanelProvider.php</file>
            <file>app/Providers/HealthServiceProvider.php</file>
            <file>app/Providers/IntegrationServiceProvider.php</file>
            <file>app/Providers/RateLimitingServiceProvider.php</file>
            <file>app/Providers/SupportServiceProvider.php</file>
            <file>app/Providers/TelescopeServiceProvider.php</file>
            <file>app/Providers/ViewServiceProvider.php</file>

            <!-- Console commands -->
            <file>app/Console/Commands/ForceDetachRoleCommand.php</file>
            <file>app/Console/Commands/RebuildDatabaseCommand.php</file>
            <file>app/Console/Commands/MakeChangelogCommand.php</file>
            <file>app/Console/Commands/TestNetIdUpdateCommand.php</file>
            <file>app/Console/Commands/ValidateConfigurationCommand.php</file>
            <file>app/Console/Commands/Concerns/RunsSteps.php</file>
            <directory>app/Console/Commands/DatabaseSnapshots</directory>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing" />
        <env name="APP_MAINTENANCE_DRIVER" value="file" />
        <env name="BCRYPT_ROUNDS" value="4" />
        <env name="CACHE_STORE" value="array" />
        <env name="DB_CONNECTION" value="phpunit" />
        <env name="MAIL_MAILER" value="array" />
        <env name="PULSE_ENABLED" value="false" />
        <env name="QUEUE_CONNECTION" value="sync" />
        <env name="BROADCAST_CONNECTION" value="log" />
        <env name="SESSION_DRIVER" value="array" />
        <env name="TELESCOPE_ENABLED" value="false" />
        <env name="WILDCARD_PHOTO_SYNC_ENABLED" value="true" />
    </php>
</phpunit>
