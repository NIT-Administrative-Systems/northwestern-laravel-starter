{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["node"],
        "moduleResolution": "Bundler",
        "noEmit": true,
        "module": "ESNext",
        "strict": true,
        "skipLibCheck": true
