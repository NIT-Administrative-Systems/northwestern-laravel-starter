APP_NAME="Northwestern Laravel Starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
PRODUCTION_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Supported: pgsql (default), mysql, sqlite
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=northwestern_laravel_starter_local
DB_USERNAME=root
DB_PASSWORD=

# For SQLite, set DB_DATABASE to the file path:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# Isolated database for PHPUnit tests to avoid destructive operations on the main database.
DB_PHPUNIT_DATABASE=northwestern_laravel_starter_test

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=file

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=2525
MAIL_USERNAME="${APP_NAME}"
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@northwestern.edu"
MAIL_FROM_NAME="${APP_NAME}"

# !! Remember to provision a bucket in the MinIO console !!
AWS_ACCESS_KEY_ID=herd
AWS_SECRET_ACCESS_KEY=secretkey
AWS_DEFAULT_REGION=us-east-1
AWS_URL=https://minio.adoes.northwestern.edu
AWS_ENDPOINT=https://minio.adoes.northwestern.edu
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_BUCKET=northwestern-laravel-starter
AWS_MINIO_CONSOLE=http://localhost:9000

# This is necessary for large files, -BUT- there is a caveat: in Herd/etc, in some cases, you will get "unable to read"
# errors because cURL cannot connect to MinIO over HTTPS. Regular, non-streamed reads work fine because the native PHP
# HTTP code is used, but cURL may be compelled (by Schannel on windows) to check the CRL for the certs, which is not
# specified since these aren't "real" certs.
#
# If you're running out of memory when processing large zip files, set this to true and use http://localhost:9000
# for the AWS_URL & AWS_ENDPOINT. That may break Wildcard photos though, since it becomes a mix of HTTP + HTTPS
# resources on the page, and your browser won't like that.
S3_STREAM_READS=false

# ─── Authentication ──────────────────────────────────────────────────────────

# Comma-separated NetIDs automatically assigned the Super Administrator role during environment setup
SUPER_ADMIN_NETIDS=

# Microsoft Entra ID SSO (default)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Online Passport / Agentless WebSSO (alternative to Entra ID)
# Setting WEBSSO_API_KEY switches the starter from Entra ID to Online Passport.
#WEBSSO_URL_BASE=https://prd-nusso.it.northwestern.edu
#WEBSSO_API_URL_BASE=https://northwestern-prod.apigee.net/agentless-websso
#WEBSSO_API_KEY=
#DUO_ENABLED=true

# Passwordless verification codes for external (non-Northwestern) users
LOCAL_AUTH_ENABLED=true

RATE_LIMIT_AUTH_LOGIN_CODE_REQUEST_PER_MINUTE=5
RATE_LIMIT_AUTH_LOGIN_CODE_REQUEST_PER_EMAIL_PER_MINUTE=3
RATE_LIMIT_AUTH_LOGIN_CODE_VERIFY_PER_MINUTE=10
RATE_LIMIT_AUTH_LOGIN_CODE_VERIFY_PER_CHALLENGE_PER_MINUTE=5
RATE_LIMIT_AUTH_IMPERSONATE_PER_MINUTE=10

# ─── API ─────────────────────────────────────────────────────────────────────

API_ENABLED=true
API_REQUEST_LOGGING_ENABLED=true
API_REQUEST_LOG_RETENTION_DAYS=90
API_REQUEST_LOGGING_SAMPLING_ENABLED=false
API_REQUEST_LOGGING_SAMPLE_RATE=1.0
API_ACCESS_TOKEN_EXPIRATION_NOTIFICATIONS_ENABLED=true
API_DEMO_USER_ACCESS_TOKEN=

RATE_LIMIT_API_PER_MINUTE=1800

# ─── Northwestern Integrations ───────────────────────────────────────────────

# Directory Search
DIRECTORY_SEARCH_API_KEY=

# Wildcard Photos
WILDCARD_PHOTO_SYNC_ENABLED=false

# EventHub
EVENT_HUB_MOCK_ENABLED=true
EVENT_HUB_BASE_URL=https://northwestern-dev.apigee.net
EVENT_HUB_API_KEY=
EVENT_HUB_HMAC_VERIFICATION_SHARED_SECRET=

# ─── Features ────────────────────────────────────────────────────────────────

# Health Checks
HEALTH_SECRET_TOKEN=
HEALTH_NOTIFICATIONS_ENABLED=false
HEALTH_NOTIFICATION_EMAIL=

# Changelog
CHANGELOG_ENABLED=false
JIRA_URL=https://nuitadminsystems.atlassian.net
JIRA_ISSUE_IDENTIFIER=

# Contact Support Form
SUPPORT_ENABLED=false
SUPPORT_LIMITED_WARNING=false
SUPPORT_DRIVER=mail
SUPPORT_MAIL_TO=your-team@northwestern.edu
SUPPORT_REFERENCE_PREFIX=SUP
RATE_LIMIT_SUPPORT_CONTACT_PER_MINUTE=2
RATE_LIMIT_SUPPORT_CONTACT_PER_HOUR=5

# TeamDynamix (only needed when SUPPORT_DRIVER=team-dynamix)
# TDX_API_BASE_URL=https://services.northwestern.edu/TDWebApi
# TDX_USERNAME=
# TDX_PASSWORD=
# TDX_TICKET_APP_NAME=
# TDX_CLIENT_APP_NAME=
# TDX_ASSIGNEE_ID=
# TDX_TICKET_TYPE=Default
# TDX_FORM_TYPE="NU Base Service Request"
# TDX_TICKET_STATUS=New
# TDX_TICKET_PRIORITY="Low (P4)"
# TDX_SERVICE=

# ─── Third-Party Services ───────────────────────────────────────────────────

# Pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=us2

# Spatie Ray
RAY_ENABLED=false

# Sentry (do not uncomment unless testing Sentry locally)
#SENTRY_LARAVEL_DSN=
#SENTRY_TRACES_SAMPLE_RATE=1.0

# ─── Testing ────────────────────────────────────────────────────────────────

# PostgreSQL binary path for database snapshots and Cypress tests.
# Only needed when DB_CONNECTION=pgsql. Leave blank to auto-discover the Herd postgres bin dir.
# MySQL and SQLite do not require this setting (their CLI tools are expected on $PATH).
# PG_BIN_DIRECTORY="C:\\Users\\<your username>\\.config\\herd\\bin\\services\\postgresql\\16\\bin"
# PG_BIN_DIRECTORY=/Users/Shared/Herd/services/postgresql/16/bin/
